<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <title>GIAN WEBPAGE</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
</head>

<body>
  <header>
    <nav id="navbar" class="bg-gray-800 p-4 h-24 fixed top-0 left-0 w-full z-50 items-center">
      <div class="container mx-auto flex justify-between items-center">
        <div class="flex items-center">
          <%= link_to root_path do %>
            <%= image_tag "GIANlogo.png", alt: "Mi Logo", class: "rounded-full h-16 w-16 mr-4" %>
          <% end %>
          <%= link_to "GIAN", root_path, class: "text-white text-xl font-bold" %>
        </div>

        <ul class="flex space-x-4">
          <li><%= link_to "Inicio", root_path, class: "text-gray-300 hover:text-white" %></li>
          <li><%= link_to "Sobre GIAN", about_me_path, class: "text-gray-300 hover:text-white" %></li>
          <li><%= link_to "PROYECTOS", proyectos_path, class: "text-gray-300 hover:text-white" %></li>
          <li><%= link_to "COMPUTACIÓN", computacion_path, class: "text-gray-300 hover:text-white" %></li>
          <li><%= link_to "FILOSOFÍA", filosofia_path, class: "text-gray-300 hover:text-white" %></li>
        </ul>
      </div>
      <button id="toggle-navbar" class="text-white bg-gray-600 px-4 py-2 rounded-full fixed top-8 right-4 z-50 ml-4">Ocultar</button>
    </nav>
  </header>

  <button id="show-navbar" class="text-white bg-gray-600 p-2 rounded-full fixed top-4 right-4 z-50 hidden">Mostrar Navbar</button>
  <div id="navbar-spacer" class="h-24"></div>

  <main>
    <%= yield %>
  </main>
  <footer id="footer" class="bg-gray-800 text-white py-12 mt-12">
    <div id="copyNotification" class="fixed bottom-4 right-4 bg-green-500 text-white px-4 py-2 rounded-lg shadow-lg hidden">
      Correo copiado al portapapeles
    </div>
    <div class="container mx-auto flex gap-32 items-start justify-center">
      <div class="flex flex-col space-y-4">
        <h4 class="text-xl font-semibold mb-2">Redes Sociales y Contacto</h4>
        <a href="https://www.youtube.com/@GIANgames55" target="_blank" class="flex items-center space-x-2 hover:text-blue-800 text-white">
          <img src="/assets/youtube_icon.png" alt="YouTube" class="w-6 h-6">
          <span>Canal de YouTube</span>
        </a>
        <a href="https://www.instagram.com/giangames55/" target="_blank" class="flex items-center space-x-2 hover:text-blue-800 text-white">
          <img src="/assets/instagram_logo.png" alt="Instagram" class="w-6 h-6">
          <span>Instagram</span>
        </a>
        <a href="https://x.com/_GIAN55" target="_blank" class="flex items-center space-x-2 hover:text-blue-800 text-white">
          <img src="/assets/x_icon.png" alt="X" class="w-6 h-6">
          <span>Cuenta de X</span>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61556143768607" target="_blank" class="flex items-center space-x-2 hover:text-blue-800 text-white">
          <img src="/assets/facebook_icon.png" alt="Facebook" class="w-6 h-6">
          <span>Página de Facebook</span>
        </a>
        <a class="flex items-center space-x-2 text-white hover:text-blue-800 cursor-pointer" onclick="copyToClipboard('gianproductions55@gmail.com')">
          <img src="/assets/email_icon.png" alt="Email" class="w-6 h-6">
          <span>gianproductions55@gmail.com</span>
        </a>
      </div>

      <div class="flex flex-col space-y-4">
        <h4 class="text-xl font-semibold mb-2">Links sobre el proyecto</h4>
        <a href="https://github.com/UandesGIAN/GIAN_personal_page" target="_blank" class="flex items-center space-x-2 hover:text-blue-800 text-white">
          <img src="/assets/github_icon.png" alt="GitHub" class="w-6 h-6">
          <span>GitHub de la página</span>
        </a>
        <a href="/historial" target="_blank" class="flex items-center space-x-2 hover:text-blue-800 text-white">
          <img src="/assets/log_icon.png" alt="logs" class="w-7 h-7">
          <span>Historial de versiones</span>
        </a>
      </div>
    </div>

    <div class="text-sm text-gray-400 text-center mt-12">
      <p>&copy; 2024 GIAN. Todos los derechos reservados.</p>
    </div>
  </footer>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

  <script>
    function copyToClipboard(text) {
      navigator.clipboard.writeText(text).then(function() {
        showNotification();
      }, function(err) {
        console.error('Error al copiar el texto: ', err);
      });
    }

    function showNotification() {
      const notification = document.getElementById('copyNotification');
      notification.classList.remove('hidden');

      setTimeout(function() {
        notification.classList.add('hidden');
      }, 3000);
    }

    document.getElementById('toggle-navbar').addEventListener('click', function() {
      const navbar = document.getElementById('navbar');
      const spacer = document.getElementById('navbar-spacer');
      const showButton = document.getElementById('show-navbar');
      
      if (navbar.style.display === 'none') {
          navbar.style.display = 'flex';
          spacer.style.display = 'block';
          showButton.style.display = 'none'; 
          this.textContent = 'Ocultar Navbar';
      } else {
          navbar.style.display = 'none';
          spacer.style.display = 'none'; 
          showButton.style.display = 'block'; 
          this.textContent = 'Mostrar Navbar'; 
      }
    });

    document.getElementById('show-navbar').addEventListener('click', function() {
      const navbar = document.getElementById('navbar');
      const spacer = document.getElementById('navbar-spacer');
      const toggleButton = document.getElementById('toggle-navbar');
      
      navbar.style.display = 'flex';
      spacer.style.display = 'block';
      this.style.display = 'none';
      toggleButton.textContent = 'Ocultar';
    });
  </script>
</body>
</html>