    function showNotification() {
      const notification = document.getElementById('copyNotification');
      notification.classList.remove('hidden');

      setTimeout(function() {
        notification.classList.add('hidden');
      }, 3000);
    }

    document.getElementById('toggle-navbar').addEventListener('click', function() {
      const navbar = document.getElementById('navbar');
      const spacer = document.getElementById('navbar-spacer');
      const showButton = document.getElementById('show-navbar');
      
      if (navbar.style.display === 'none') {
          navbar.style.display = 'flex';
          spacer.style.display = 'block';
          showButton.style.display = 'none'; 
          this.textContent = 'Ocultar Navbar';
          this.style.opacity = '1'; 
      } else {
          navbar.style.display = 'none';
          spacer.style.display = 'none'; 
          showButton.style.display = 'block'; 
          this.textContent = 'Mostrar Navbar';
          this.style.opacity = '0'; 
      }
    });

    document.getElementById('show-navbar').addEventListener('click', function() {
      const navbar = document.getElementById('navbar');
      const spacer = document.getElementById('navbar-spacer');
      const toggleButton = document.getElementById('toggle-navbar');
      
      navbar.style.display = 'flex';
      spacer.style.display = 'block';
      this.style.display = 'none';
      toggleButton.textContent = 'Ocultar Navbar';
      toggleButton.style.opacity = '1'; 
    });

    const boton = document.querySelector('#boton');
    const overlay = document.getElementById('overlay');

    boton.addEventListener('click', () => {
      overlay.classList.toggle('hidden')
    });
    document.addEventListener('click', (event) => {
      if (!overlay.contains(event.target) && !boton.contains(event.target)) {
        overlay.classList.add('hidden');
      }
    });
    
    function updateAnimationSpeed() {
      const screenHeight = window.innerHeight; // Altura de la pantalla
      const baseSpeed = 10; // Velocidad base en segundos

      // Cuanto más alta sea la pantalla, más lento será el movimiento
      const newSpeed = baseSpeed + (screenHeight / 200); 

      document.documentElement.style.setProperty('--animation-speed', `${newSpeed}s`);
    }

    // Ejecutar la función al cargar y al cambiar el tamaño de la ventana
    window.addEventListener("load", updateAnimationSpeed);
    window.addEventListener("resize", updateAnimationSpeed);
  </script>
