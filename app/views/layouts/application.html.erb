<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="icon" href="/assets/gian_icon.png" type="image/png">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=release_alert" />
  <title>GIAN WEBPAGE</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
  <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  <script>
  window.MathJax = {
    tex: {
      inlineMath: [['\\(', '\\)']],
      displayMath: [['\\[', '\\]']]
    },
    svg: {
      fontCache: 'global'
    }
  };
</script>
<script id="MathJax-script" async
  src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js">
</script>
</head>

<body>
  <!-- BARRA DE NAVEGACION -->
  <header>
    <nav id="navbar" class="<%= 'bg-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900' if @modo_luz == 'oscuro' %>  p-4 h-24 fixed top-0 left-0 w-full z-50 flex items-center">
      <div class="container mx-auto flex justify-between items-center flex-wrap relative">
        <div class="flex items-center">
          <%= link_to root_path do %>
            <%= image_tag "GIANlogo.png", alt: "Mi Logo", class: "rounded-full h-16 w-16 mr-4" %>
          <% end %>
          <%= link_to "GIAN", root_path, class: "ml-1 text-white text-2xl font-bold" %>
        </div>

        <!-- Botón de menú (solo visible en móviles) -->
        <button id="boton" class="text-white bg-gray-800 p-2 rounded-lg block md:hidden">
          <span class="material-icons">menu</span>
        </button>

        <!-- Menú principal (solo visible en escritorio) -->
        <ul class="hidden md:flex space-x-4 mt-4 md:mt-0 md:flex-row flex-col ml-auto">
          <li><%= link_to "Inicio", root_path, class: "text-gray-300 hover:text-white" %></li>
          <li><%= link_to "Sobre GIAN", sobre_mi_path, class: "text-gray-300 hover:text-white" %></li>
          <li><%= link_to "PROYECTOS", proyectos_subsection_path, class: "text-gray-300 hover:text-white" %></li>
          <li><%= link_to "COMPUTACIÓN", computacion_subsection_path, class: "text-gray-300 hover:text-white" %></li>
          <li><%= link_to "FILOSOFÍA", filosofia_subsection_path, class: "text-gray-300 hover:text-white" %></li>
          <!-- Menú de opciones de modo de luz (visible en escritorio) -->
          <li>
            <span id="light-button" class="flex text-gray-300 z-50 pl-4" style="cursor: pointer;">Modo de luz
              <i id="icon-card1" class="material-icons ml-4 rotate-icon" 
                style="color: #ffffff; margin-top: 4px; font-size: 12px; transition: color 0.3s ease;">keyboard_arrow_up
              </i>
            </span>
            <div id="light-menu" class="hidden absolute <%= 'bg-gray-800 border-gray-700' if @modo_luz == 'claro' %> 
              <%= 'bg-gray-900 border-gray-800' if @modo_luz == 'oscuro' %> rounded-lg text-white mt-4 w-28 z-50">
              <ul class="text-sm">
                <li><a href="#" id="option-claro" class="block w-full px-4 py-2 text-white font-bold hover:bg-gray-700">Claro</a></li>
                <li><a href="#" id="option-oscuro" class="block w-full px-4 py-2 text-white font-bold hover:bg-gray-700">Oscuro</a></li>
              </ul>
            </div>
          </li>
        </ul>

        <!-- Menú desplegable de modo de luz (solo visible en móviles en el overlay) -->
        <div id="overlay" class="hidden fixed top-14 right-2 bg-gray-800 text-white p-2 rounded-lg shadow-lg z-50">
          <p><%= link_to "Inicio", root_path, class: "text-gray-300 hover:text-white" %></p>
          <p><%= link_to "Sobre GIAN", sobre_mi_path, class: "text-gray-300 hover:text-white" %></p>
          <p><%= link_to "PROYECTOS", proyectos_subsection_path, class: "text-gray-300 hover:text-white" %></p>
          <p><%= link_to "COMPUTACIÓN", computacion_subsection_path, class: "text-gray-300 hover:text-white" %></p>
          <p><%= link_to "FILOSOFÍA", filosofia_subsection_path, class: "text-gray-300 hover:text-white" %></p>
          <!-- Menú de opciones de modo de luz (visible en móviles) -->
          <p>
            <span id="light-button-mobile" class="flex text-gray-300 z-50 cursor-pointer">Modo de luz
              <i id="icon-card1-mobile" class="material-icons ml-4 rotate-icon" 
                style="color: #ffffff; margin-top: 4px; font-size: 12px; transition: color 0.3s ease;">keyboard_arrow_up
              </i>
            </span>
            <div id="light-menu-mobile" class="hidden absolute <%= 'bg-gray-800 border-gray-700' if @modo_luz == 'claro' %> 
              <%= 'bg-gray-900 border-gray-800' if @modo_luz == 'oscuro' %> rounded-lg text-white mt-4 w-28 z-50">
              <ul class="text-sm">
                <li><a href="#" id="option-claro-mobile" class="block py-2 px-4 text-white font-bold hover:bg-gray-700">Claro</a></li>
                <li><a href="#" id="option-oscuro-mobile" class="block py-2 px-4 text-white font-bold hover:bg-gray-700">Oscuro</a></li>
              </ul>
            </div>
          </p>
        </div>
      </div>
    </nav>
  </header>

  <!-- BOTON OCULTAR/MOSTRAR -->
  <button id="toggle-navbar" class="text-white bg-gray-600 p-2 rounded-full fixed top-28 right-4 z-10">Ocultar barra</button>
  <button id="show-navbar" class="text-white bg-gray-600 p-2 rounded-full fixed top-4 right-4 z-10 hidden">Mostrar barra</button>
  <div id="navbar-spacer" class="h-24"></div>

  <main class="px-4 md:px-0">
    <%= yield %>
  </main>


  <!-- PIE DE PAGINA -->
  <footer id="footer" class="bg-gray-900 text-gray-300 py-12 mt-12">
    <div id="copyNotification" class="fixed bottom-4 right-4 bg-green-500 text-gray-300 px-4 py-2 rounded-lg shadow-lg hidden">
      Correo copiado al portapapeles
    </div>

    <div class="container mx-auto flex flex-wrap gap-12 md:gap-24 items-center justify-between">
      <!-- REDES SOCIALES Y CONTACTO -->
      <div class="flex flex-col space-y-6 w-full md:w-1/3">
        <h4 class="text-2xl font-bold mb-4 text-center md:text-left">Redes Sociales y Contacto</h4>

        <div class="flex flex-col space-y-4 items-center md:items-start">
          <a href="https://www.youtube.com/@GIANgames55" target="_blank" class="flex items-center space-x-3 hover:text-blue-500 transition-colors duration-300">
            <img src="/assets/youtube_icon.png" alt="YouTube" class="w-8 h-8">
            <span class=" text-md">Canal de YouTube</span>
          </a>

          <a href="https://www.instagram.com/giangames55/" target="_blank" class="flex items-center space-x-3 hover:text-blue-500 transition-colors duration-300">
            <img src="/assets/instagram_logo.png" alt="Instagram" class="w-8 h-8">
            <span class=" text-md">Instagram de Youtube</span>
          </a>

          <a href="https://x.com/_GIAN55" target="_blank" class="flex items-center space-x-3 hover:text-blue-500 transition-colors duration-300">
            <img src="/assets/x_icon.png" alt="X" class="w-8 h-8">
            <span class=" text-md">Cuenta de X</span>
          </a>

          <a href="https://www.facebook.com/profile.php?id=61556143768607" target="_blank" class="flex items-center space-x-3 hover:text-blue-500 transition-colors duration-300">
            <img src="/assets/facebook_icon.png" alt="Facebook" class="w-8 h-8">
            <span class=" text-md">Página de Facebook</span>
          </a>

          <a href="mailto:gianproductions55@gmail.com" class="flex items-center space-x-3  hover:text-blue-500 cursor-pointer transition-colors duration-300" onclick="copyToClipboard('gianproductions55@gmail.com')">
            <img src="/assets/email_icon.png" alt="Email" class="w-8 h-8">
            <span class=" text-md">gianproductions55@gmail.com</span>
          </a>
        </div>
      </div>

      <!-- LINKS SOBRE EL PROYECTO -->
      <div class="flex flex-col space-y-6 w-full md:w-1/3">
        <h4 class="text-2xl font-bold mb-4 text-center md:text-left">Links sobre el proyecto</h4>
        <!--<div class="flex flex-col space-y-4 items-center md:items-start">
          <a href="https://github.com/UandesGIAN" target="_blank" class="flex items-center space-x-3 hover:text-blue-500 transition-colors duration-300">
            <img src="/assets/github_icon.png" alt="GitHub" class="w-8 h-8">
            <span class=" text-md">GitHub personal</span>
          </a>-->

          <%= link_to versiones_path, class: "flex items-center space-x-2 hover:text-blue-500 transition-colors duration-300" do %>
            <%= image_tag "log_icon.png", alt: "logs", class: "w-9 h-8" %>
            <span class=" text-md">Historial de versiones</span>
          <% end %>

          <%= link_to publicaciones_path, class: "flex items-center space-x-3 hover:text-blue-500 transition-colors duration-300" do %>
            <%= image_tag "post_icon.png", alt: "logs", class: "ml-1 w-7 h-7" %>
            <span class=" text-md">Publicaciones de GIAN</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="text-sm text-gray-400 text-center mt-12">
      <p>&copy; 2024 GIAN. Todos los derechos reservados.</p>
    </div>
  </footer>


  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

  <!-- JAVASCRIPT PARA ANIMACIONES Y MOSTRAR/OCULTAR -->
  <script>
    function copyToClipboard(text) {
      navigator.clipboard.writeText(text).then(function() {
        showNotification();
      }, function(err) {
        console.error('Error al copiar el texto: ', err);
      });
    }
    
    // BOTON Modo de luz EN ESCRITORIO
    document.getElementById('light-button').addEventListener('click', function() {
      const menu = document.getElementById('light-menu');
      const icon = document.getElementById('icon-card1');
      
      // Alternar la visibilidad del menú
      menu.classList.toggle('hidden'); 

      // Rotar la flecha
      icon.classList.toggle('rotate-180');
    });

    // EFECTOS VISUALES
    const lightOptions = document.querySelectorAll('#light-menu a');
    lightOptions.forEach(option => {
      option.addEventListener('mouseenter', function() {
        this.classList.add('bg-gray-900'); // Oscurece ligeramente
      });
      option.addEventListener('mouseleave', function() {
        this.classList.remove('bg-gray-700'); // Restaura el color original
      });
    });

    const lightButton = document.getElementById('light-button');
    const icon = document.getElementById('icon-card1');

    lightButton.addEventListener('mouseover', () => {
      lightButton.style.backgroundColor = '#1d2430'; // Color de fondo oscurecido
    });
    lightButton.addEventListener('mouseout', () => {
      lightButton.style.backgroundColor = '#1f2937'; // Color de fondo original
    });

    // BOTON Modo de luz EN MOVIL
    document.getElementById('light-button-mobile').addEventListener('click', function() {
      const menu = document.getElementById('light-menu-mobile');
      const icon = document.getElementById('icon-card1-mobile');
      
      // Alternar la visibilidad del menú
      menu.classList.toggle('hidden'); 

      // Rotar la flecha
      icon.classList.toggle('rotate');
    });

    // Opciones de Modo de luz - cambio de color al pasar el ratón
    const lightOptionsMobile = document.querySelectorAll('#light-menu-mobile a');
    lightOptionsMobile.forEach(option => {
      option.addEventListener('mouseenter', function() {
        this.classList.add('bg-gray-900'); // Oscurece ligeramente
      });
      option.addEventListener('mouseleave', function() {
        this.classList.remove('bg-gray-700'); // Restaura el color original
      });
    });

    // Cambiar color del texto e icono al hacer hover sobre el button de Modo de luz
    const lightButtonMobile = document.getElementById('light-button-mobile');
    const iconMobile = document.getElementById('icon-card1-mobile');

    lightButtonMobile.addEventListener('mouseover', () => {
      lightButtonMobile.style.backgroundColor = '#1d2430'; // Color de fondo oscurecido
    });

    lightButtonMobile.addEventListener('mouseout', () => {
      lightButtonMobile.style.backgroundColor = '#1f2937'; // Color de fondo original
    });

    function showNotification() {
      const notification = document.getElementById('copyNotification');
      notification.classList.remove('hidden');

      setTimeout(function() {
        notification.classList.add('hidden');
      }, 3000);
    }

    document.addEventListener("DOMContentLoaded", function () {
      const optionClaro = document.getElementById("option-claro");
      const optionOscuro = document.getElementById("option-oscuro");
      const optionClaroMobile = document.getElementById("option-claro-mobile");
      const optionOscuroMobile = document.getElementById("option-oscuro-mobile");

      const ACTIVE_COLOR = "#48BB79"; // verde
      const INACTIVE_COLOR = "#D1D5D8"; // gris claro

      function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
      }

      function setCookie(name, value) {
        document.cookie = `${name}=${encodeURIComponent(value)}; path=/; max-age=31536000`; // 1 año
      }

      function updateSelectedOption(selected) {
        const optionClaro = document.getElementById("option-claro");
        const optionOscuro = document.getElementById("option-oscuro");
        const optionClaroMobile = document.getElementById("option-claro-mobile");
        const optionOscuroMobile = document.getElementById("option-oscuro-mobile");

        if (selected === "claro") {
          optionClaro.style.color = ACTIVE_COLOR;
          optionOscuro.style.color = INACTIVE_COLOR;
          if (optionClaroMobile && optionOscuroMobile) {
            optionClaroMobile.style.color = ACTIVE_COLOR;
            optionOscuroMobile.style.color = INACTIVE_COLOR;
          }
        } else if (selected === "oscuro") {
          optionClaro.style.color = INACTIVE_COLOR;
          optionOscuro.style.color = ACTIVE_COLOR;
          if (optionClaroMobile && optionOscuroMobile) {
            optionClaroMobile.style.color = INACTIVE_COLOR;
            optionOscuroMobile.style.color = ACTIVE_COLOR;
          }
        }
      }

      // Obtener el valor actual de la cookie o establecer "claro" por defecto
      let savedMode = getCookie("modo_luz");

      if (!savedMode) {
        savedMode = "claro";
        setCookie("modo_luz", savedMode);
      }

      updateSelectedOption(savedMode);

      // Eventos al hacer clic
      optionClaro.addEventListener("click", function (e) {
        e.preventDefault();
        document.cookie = "modo_luz=claro; path=/";
        updateSelectedOption("claro");
        location.reload()
      });

      optionOscuro.addEventListener("click", function (e) {
        e.preventDefault();
        document.cookie = "modo_luz=oscuro; path=/";
        updateSelectedOption("oscuro");
        location.reload()
      });

      if (optionClaroMobile) {
        optionClaroMobile.addEventListener("click", function (e) {
          e.preventDefault();
          setCookie("modo_luz", "claro");
          updateSelectedOption("claro");
          location.reload()
        });
      }

      if (optionOscuroMobile) {
        optionOscuroMobile.addEventListener("click", function (e) {
          e.preventDefault();
          setCookie("modo_luz", "oscuro");
          updateSelectedOption("oscuro");
          location.reload()
        });
      }
    });

    document.addEventListener("click", function(event) {
      const menu = document.getElementById("light-menu");
      const button = document.getElementById("light-button");
      const menuMobile = document.getElementById("light-menu-mobile");
      const buttonMobile = document.getElementById("light-button-mobile");

      if (!menu.contains(event.target) && !button.contains(event.target)) {
        menu.classList.add("hidden");
        icon.classList.remove("rotate-180");
      }
      if (!menuMobile.contains(event.target) && !buttonMobile.contains(event.target)) {
        menuMobile.classList.add("hidden");
        icon.classList.remove("rotate");
      }
    });

    document.getElementById('toggle-navbar').addEventListener('click', function() {
      const navbar = document.getElementById('navbar');
      const spacer = document.getElementById('navbar-spacer');
      const showButton = document.getElementById('show-navbar');
      
      if (navbar.style.display === 'none') {
          navbar.style.display = 'flex';
          spacer.style.display = 'block';
          showButton.style.display = 'none'; 
          this.textContent = 'Ocultar Navbar';
          this.style.opacity = '1'; 
      } else {
          navbar.style.display = 'none';
          spacer.style.display = 'none'; 
          showButton.style.display = 'block'; 
          this.textContent = 'Mostrar Navbar';
          this.style.opacity = '0'; 
      }
    });

    document.getElementById('show-navbar').addEventListener('click', function() {
      const navbar = document.getElementById('navbar');
      const spacer = document.getElementById('navbar-spacer');
      const toggleButton = document.getElementById('toggle-navbar');
      
      navbar.style.display = 'flex';
      spacer.style.display = 'block';
      this.style.display = 'none';
      toggleButton.textContent = 'Ocultar Navbar';
      toggleButton.style.opacity = '1'; 
    });

    const boton = document.querySelector('#boton');
    const overlay = document.getElementById('overlay');

    boton.addEventListener('click', () => {
      overlay.classList.toggle('hidden')
    });
    document.addEventListener('click', (event) => {
      if (!overlay.contains(event.target) && !boton.contains(event.target)) {
        overlay.classList.add('hidden');
      }
    });
    
    function updateAnimationSpeed() {
      const screenHeight = window.innerHeight; // Altura de la pantalla
      const baseSpeed = 10; // Velocidad base en segundos

      // Cuanto más alta sea la pantalla, más lento será el movimiento
      const newSpeed = baseSpeed + (screenHeight / 200); 

      document.documentElement.style.setProperty('--animation-speed', `${newSpeed}s`);
    }

    // Ejecutar la función al cargar y al cambiar el tamaño de la ventana
    window.addEventListener("load", updateAnimationSpeed);
    window.addEventListener("resize", updateAnimationSpeed);
  </script>
</body>
</html>
