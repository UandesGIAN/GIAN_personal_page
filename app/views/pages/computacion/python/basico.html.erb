			<div>
				<a href="<%= computacion_subsection_path(section: 'python', sub_section: 'historia_y_origen') %>" class="bg-blue-700 text-white py-3 px-4 rounded-md hover:bg-blue-800 transition-all">
					Anterior capítulo
				</a>
			</div>
			<div>
