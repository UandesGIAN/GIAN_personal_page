<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-6xl md:text-8xl sm:text-8xl xs:text-4xl text-center mb-2 text-shadow-orange filosofia-home animate-slide-in-right">
    Filosofía de GIAN<p class="mt-10" style="color: #8000B3; text-shadow: 0px 2px 20px rgba(146, 0, 204, 0.6);">LOS ELEMENTOS DE VIDA</p>
  </h1>
</div>

<%= @indice_content %>

<div class="text-container max-w-7xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section id="bg-articulos" class="p-6 
    <%= 'bg-gray-200 sm:bg-gray-300 text-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900 text-gray-300' if @modo_luz == 'oscuro' %> 
    rounded-2xl shadow-md flex-grow">
    <h2 class="text-4xl sm:text-3xl lg:text-5xl text-center font-bold mb-" style="color: #8000B3;">5. El Ser Total</h2>

    <p class="mb-6 text-lg">
      <i>Work In Progress...</i>
    </p>

    <div class="flex justify-between items-center">
        <div>
            <a href="<%= filosofia_subsection_path(section: 'los_elementos_de_vida', sub_section: 'los_estados_compuestos') %>" 
                class="text-white py-3 px-4 rounded-md transition-all"
                style="background-color: rgb(134, 0, 183);"
                onmouseover="this.style.backgroundColor='rgb(116, 0, 163)'"
                onmouseout="this.style.backgroundColor='rgb(134, 0, 183)'">
                Anterior capítulo
            </a>
        </div>
        <div>
            <a href="<%= filosofia_subsection_path(section: 'los_elementos_de_vida', sub_section: 'sobre_la_amistad') %>" 
                class="text-white py-3 px-4 rounded-md transition-all"
                style="background-color: rgb(134, 0, 183);"
                onmouseover="this.style.backgroundColor='rgb(116, 0, 163)'"
                onmouseout="this.style.backgroundColor='rgb(134, 0, 183)'">
                Siguiente capítulo
            </a>
        </div>
    </div>

  </section>
</div>
