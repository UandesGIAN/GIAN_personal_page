<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-6xl md:text-8xl sm:text-8xl xs:text-4xl text-center mb-2 text-blue-700 animate-slide-in-right">
    <span class="text-shadow-proyectos">Mis proyectos:</span> <p class="mt-10" style="color: #4e009c; text-shadow: 0px 2px 20px rgba(78, 0, 156, 0.6);">Rankings</p>
  </h1>
</div>

<%= @indice_content %>

<div class="text-container max-w-7xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section class="p-6 bg-gray-100 text-gray-800">
    <h2 class="text-4xl sm:text-3xl lg:text-5xl mt-2 text-center font-bold mb-4" style="color: #4e009c">2. TOP 3 Canciones X Tipo</h2>

    <p class="mb-6 text-lg">
      <i>Work In Progress...</i>
    </p>

    <div class="flex justify-between items-center">
        <div>
            <a href="<%= proyectos_subsection_path(section: 'rankings', sub_section: 'los_mejores_capitulos_de_algunas_series_que_he_visto') %>" 
                class="text-white py-3 px-4 rounded-md transition-all"
                style="background-color: rgb(78, 0, 156);"
