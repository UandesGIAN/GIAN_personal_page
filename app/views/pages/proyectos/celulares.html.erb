<!-------------------------------->
<!--        12. CELULARES       -->
<!-------------------------------->

<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-6xl md:text-8xl sm:text-8xl xs:text-4xl text-center mb-2 text-blue-700 animate-slide-in-right">
    <span class="text-shadow-proyectos">Mis proyectos:</span> <p class="mt-10" style="color: #8600c9; text-shadow: 0px 2px 20px rgba(134, 0, 201, 0.6);">Celulares</p>
  </h1>
</div>

<%= @indice_content %>

<!-- ESTRUCTURA -->
<div class="text-container max-w-5xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section class="p-6 bg-gray-300 text-gray-800 rounded-2xl shadow-md flex-grow">
    <!-- DESCRIPCION -->
    <p class="mb-6 text-lg ">
        <i>Work in progress...</i>
    </p>


    <!-- SECCIONES -->
    <h2 class="text-5xl mt-14 text-center font-bold mb-4" style="color: #8600c9;">Secciones:</h2>

    <a href="<%= proyectos_subsection_path(section: 'celulares') %>" style="color: #8600c9;">
    </a>
    <% if @subsections['Celulares'].present? %>
      <div class="flex flex-col items-center"> 
        <ul class="list-inside text-experimentos text-left mt-2">
          <% @subsections['Celulares'].each_with_index do |sub_section, index| %>
            <li>
              <a href="<%= proyectos_subsection_path(section: 'celulares', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_')) %>" class="text-2xl font-bold flex items-center" style="color: #8600c9;">
                <%= if @new_subsections['Celulares'] && @new_subsections['Celulares'].include?(sub_section)
                      raw("<span class='underline'>12.#{index + 1} #{sub_section}</span> <span class='ml-1 mr-1 material-symbols-outlined' style='color: #8600c9 !important;font-size: 22px;'>release_alert</span>")
                    else
                      raw("<span class='underline'>12.#{index + 1} #{sub_section}</span>")
                    end %>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>
</div>