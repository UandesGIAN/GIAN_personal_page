<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-6xl md:text-8xl sm:text-8xl xs:text-4xl text-center mb-2 text-blue-700 animate-slide-in-right">
    <span class="text-shadow-proyectos">Mis proyectos:</span> <p class="mt-10" style="color: #50B300; text-shadow: 0px 2px 20px rgba(91, 201, 0, 0.6);">Consolas</p>
  </h1>
</div>

<%= @indice_content %>

<div class="text-container max-w-7xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section id="bg-articulos" class="p-6 
    <%= 'bg-gray-200 sm:bg-gray-300 text-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900 text-gray-300' if @modo_luz == 'oscuro' %> 
    rounded-2xl shadow-md flex-grow">
    <h2 class="text-4xl sm:text-3xl lg:text-5xl mt-2 text-center font-bold mb-4" style="color: #50B300;">1. Xbox 360</h2>

    <p class="mb-6 text-lg">
      <i>Work In Progress...</i>
    </p>

    <div class="flex justify-end">
        <div>
            <a href="<%= proyectos_subsection_path(section: 'consolas', sub_section: 'nintendo_ds') %>" 
                class="text-gray-600 py-3 px-4 rounded-md transition-all"
                style="background-color: rgb(91, 201, 0);"
                onmouseover="this.style.backgroundColor='rgb(80, 170, 0)'"
                onmouseout="this.style.backgroundColor='rgb(91, 201, 0)'">
                Siguiente capítulo
            </a>
        </div>
    </div>

  </section>
</div>
