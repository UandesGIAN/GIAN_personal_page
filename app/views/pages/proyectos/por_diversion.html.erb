<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-center xl:text-8xl mb-2 text-blue-700 animate-slide-in-right">
    <span class="text-shadow-proyectos">Mis proyectos:</span> <p class="mt-4 text-experimentos">Por diversión</p>
  </h1>
</div>

<%= @indice_content %>

<div class="text-container max-w-5xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section class="p-6 bg-gray-100 text-gray-800">
    <p class="mb-6 text-lg ">
        <i>Work in progress...</i>
    </p>

    <h2 class="text-5xl mt-14 text-center font-bold mb-4 text-experimentos">Secciones:</h2>

    <a href="<%= proyectos_subsection_path(section: 'por_diversion') %>" class="text-experimentos">
    </a>
    <% if @subsections['Por diversion'].present? %>
      <div class="flex flex-col items-center"> 
        <ul class="list-inside text-experimentos text-left mt-2">
          <% @subsections['Por diversion'].each_with_index do |sub_section, index| %>
            <li>
              <a href="<%= proyectos_subsection_path(section: 'por_diversion', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_')) %>" 
                class="text-experimentos text-2xl font-bold underline">
                <%= "#{index + 1} #{sub_section}" %>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>
</div>