<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-6xl md:text-8xl sm:text-8xl xs:text-4xl text-center mb-2 text-blue-700 animate-slide-in-right">
    <span class="text-shadow-proyectos">Mis proyectos:</span> <p class="mt-10" style="color: #1E90FF; text-shadow: 0px 2px 20px rgba(30, 144, 255, 0.6);">PC</p>
  </h1>
</div>

<%= @indice_content %>

<div class="text-container max-w-7xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section id="bg-articulos" class="p-6 
    <%= 'bg-gray-200 sm:bg-gray-300 text-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900 text-gray-300' if @modo_luz == 'oscuro' %> 
    rounded-2xl shadow-md flex-grow">
    <h2 class="text-4xl sm:text-3xl lg:text-5xl mt-2 text-center font-bold mb-4" style="color: #1E90FF;">4. Dual Boot</h2>

    <p class="mb-12 text-lg leading-9">
      <i>Work In Progress...</i>
    </p>

    <div class="flex justify-between items-center">
        <div>
            <a href="<%= proyectos_subsection_path(section: 'pc', sub_section: 'reparacion_de_componentes') %>" 
                class="text-white sm:py-3 py-2 px-3 rounded-md transition-all"
                style="background-color: rgb(30, 144, 255);"
                onmouseover="this.style.backgroundColor='rgb(22, 108, 191)'"
                onmouseout="this.style.backgroundColor='rgb(30, 144, 255)'">
                Anterior capítulo
            </a>
        </div>
        <div>
            <a href="<%= proyectos_subsection_path(section: 'pc', sub_section: 'wake-on-lan_y_control_remoto') %>" 
                class="text-white sm:py-3 py-2 px-3 rounded-md transition-all"
                style="background-color: rgb(30, 144, 255);"
                onmouseover="this.style.backgroundColor='rgb(22, 108, 191)'"
                onmouseout="this.style.backgroundColor='rgb(30, 144, 255)'">
                Siguiente capítulo
            </a>
        </div>
    </div>

  </section>
</div>
