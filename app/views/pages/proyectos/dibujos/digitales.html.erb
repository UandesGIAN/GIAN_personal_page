<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-6xl md:text-8xl sm:text-8xl xs:text-4xl text-center mb-2 text-blue-700 animate-slide-in-right">
    <span class="text-shadow-proyectos">Mis proyectos:</span> <p class="mt-10" style="color: #BDAD00; text-shadow: 0px 2px 20px rgba(222, 203, 0, 0.6);">Dibujos</p>
  </h1>
</div>

<%= @indice_content %>

<!-- ESTRUCTURA -->
<div class="text-container max-w-7xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section id="bg-articulos" class="p-6 
    <%= 'bg-gray-200 sm:bg-gray-300 text-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900 text-gray-300' if @modo_luz == 'oscuro' %> 
    rounded-2xl shadow-md flex-grow">
    <!-- TITULO -->
    <h2 class="text-4xl sm:text-3xl lg:text-5xl mt-2 text-center font-bold mb-4" style="color: #BDAD00;">6. Dígitales</h2>

    <!-- INTRODUCCIÓN -->
    <p class="mb-12 text-lg leading-9">
      Aqui pongo los dibujos digitales que he hecho, en general experimentos o de Splatoon para el proyecto de MMD.
    </p>

    <!-- INDICE -->
    <h2 class="text-4xl sm:text-4xl lg:text-5xl mt-40 text-center font-bold mb-4" style="color: #BDAD00">Índice</h2>
    <div class="flex justify-center mb-40" style="color: #BDAD00">
      <ul class="list-disc text-lg">
        <li><a href="#61-hechos-en-pc" class="text-xl mt-2 text-center font-bold mb-4 underline" style="color: #BDAD00">6.1 Hechos en PC</a></li>
        <li><a href="#62-hechos-en-celular" class="text-xl mt-2 text-center font-bold mb-4 underline" style="color: #BDAD00">6.2 Hechos en celular</a></li>
      </ul>
    </div>

    <!-- CONTENIDO -->
    <h2 id="61-hechos-en-pc" class="text-xl sm:text-3xl lg:text-5xl mt-2 text-center font-bold mb-4" style="color: #BDAD00">
      6.1 Hechos en PC
    </h2>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/1.png" alt="Pixel art antiguo" class="w-1/2">
      <p class="mt-2 text-lg text-center">Pixel art antiguo</p>
    </div>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/2.png" alt="Pixel art antiguo 2" class="w-1/2">
      <p class="mt-2 text-lg text-center">Pixel art antiguo 2</p>
    </div>
    <h2 id="62-hechos-en-celular" class="text-xl sm:text-3xl lg:text-5xl mt-2 text-center font-bold mb-4" style="color: #BDAD00">
      6.2 Hechos en celular
    </h2>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/Delta.jfif" alt="Delta dibujo conceptual MMD Splatoon" class="w-1/2">
      <p class="mt-2 text-lg text-center">Delta dibujo conceptual MMD Splatoon</p>
    </div>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/Moe.jfif" alt="Moe dibujo conceptual MMD Splatoon" class="w-1/2">
      <p class="mt-2 text-lg text-center">Moe dibujo conceptual MMD Splatoon</p>
    </div>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/Ruby_01.jfif" alt="Ruby dibujo oficial MMD Splatoon" class="w-1/2">
      <p class="mt-2 text-lg text-center">Ruby dibujo oficial MMD Splatoon</p>
    </div>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/Ruby_01_png.jfif" alt="Ruby dibujo oficial MMD Splatoon (sin fondo)" class="w-1/2">
      <p class="mt-2 text-lg text-center">Ruby dibujo oficial MMD Splatoon (sin fondo)</p>
    </div>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/Ruby_02.jfif" alt="Ruby dibujo edit inkling chica Smash Ultimate" class="w-1/2">
      <p class="mt-2 text-lg text-center">Ruby dibujo edit inkling chica Smash Ultimate</p>
    </div>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/Ruby_03.jfif" alt="RUby dibujo en la calle arte" class="w-1/2">
      <p class="mt-2 text-lg text-center">RUby dibujo en la calle arte</p>
    </div>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/Z%C3%A6c.JPG" alt="Zæc dibujo conceptual MMD Splatoon" class="w-1/2">
      <p class="mt-2 text-lg text-center">Zæc dibujo conceptual MMD Splatoon</p>
    </div>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/Z%C3%A6c_Perfil.jfif" alt="Zæc dibujo conceptual cara MMD Splatoon" class="w-1/2">
      <p class="mt-2 text-lg text-center">Zæc dibujo conceptual cara MMD Splatoon</p>
    </div>
    <div class="flex flex-col items-center mb-20 mt-12">
      <img src="/assets/./mis_dibujos/digital/claire.png" alt="Claire dibujo conceptual MMD Splatoon" class="w-1/2">
      <p class="mt-2 text-lg text-center">Claire dibujo conceptual MMD Splatoon</p>
    </div>

    <div class="flex justify-between items-center">
        <div>
            <a href="<%= proyectos_subsection_path(section: 'dibujos', sub_section: '2023-24') %>" 
                class="text-gray-600 py-3 px-4 rounded-md transition-all"
                style="background-color: rgb(222, 203, 0);"
                onmouseover="this.style.backgroundColor='rgb(200, 180, 0)'"
                onmouseout="this.style.backgroundColor='rgb(222, 203, 0)'">
                Anterior capítulo
            </a>
        </div>
    </div>

  </section>
</div>



<% stats = stats_for_page(request.path) %>
<div class="text-container max-w-7xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section id="bg-articulos" class="p-6 
    <%= 'bg-gray-200 sm:bg-gray-300 text-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900 text-gray-300' if @modo_luz == 'oscuro' %> 
    rounded-2xl shadow-md flex-grow">
    <h2 class="text-5xl mt-4 text-center font-bold mb-8" style="color: #BDAD00;">Estadísticas de esta página</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
        <div class="<%= 'bg-indigo-200 text-gray-800' if @modo_luz == 'claro' %> 
        <%= 'bg-indigo-500 text-gray-900' if @modo_luz == 'oscuro' %> rounded-lg p-4">
        <p class="text-lg font-semibold <%= 'text-indigo-800' if @modo_luz == 'claro'%> <%= 'text-indigo-900' if @modo_luz == 'oscuro' %>">Visitas totales</p>
        <p class="text-3xl font-bold"><%= stats["visits"] %></p>
        </div>
        <div class="<%= 'bg-green-200 text-gray-800' if @modo_luz == 'claro' %> 
        <%= 'bg-green-400 text-gray-900' if @modo_luz == 'oscuro' %> rounded-lg p-4">
        <p class="text-lg font-semibold <%= 'text-green-800' if @modo_luz == 'claro'%> <%= 'text-green-900' if @modo_luz == 'oscuro' %>">Usuarios activos</p>
        <p class="text-3xl font-bold"><%= stats["current_users"].length %></p>
        </div>
        <div class="<%= 'bg-yellow-200 text-gray-800' if @modo_luz == 'claro' %> 
        <%= 'bg-yellow-400 text-gray-900' if @modo_luz == 'oscuro' %> rounded-lg p-4">
        <p class="text-lg font-semibold text-yellow-800">Última visita</p>
        <p class="text-lg font-semibold"><%= stats["last_visit"] %></p>
        </div>
    </section>
    </div>
</div>