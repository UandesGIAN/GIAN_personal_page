<!-------------------------------->
<!--            7. PC           -->
<!-------------------------------->

<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-6xl md:text-8xl sm:text-8xl xs:text-4xl text-center mb-2 text-blue-700 animate-slide-in-right">
    <span class="text-shadow-proyectos">Mis proyectos:</span> <p class="mt-10" style="color: #1E90FF; text-shadow: 0px 2px 20px rgba(30, 144, 255, 0.6);">PC</p>
  </h1>
</div>

<%= @indice_content %>

<!-- ESTRUCTURA -->
<div class="text-container max-w-5xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section id="bg-articulos" class="p-6 
    <%= 'bg-gray-200 sm:bg-gray-300 text-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900 text-gray-300' if @modo_luz == 'oscuro' %> 
    rounded-2xl shadow-md flex-grow">
    <!-- DESCRIPCION -->
    <p class="mb-12 text-lg leading-9">
        Sección dedicada a los experimentos que he realizado en relación a computadoras y mi computador personal principal. Al igual que los otros apartados, principalmente enfocado en la experiencia y aprendizajes, sin la intención de ser una guía o tutorial.
        <br><br>
        <i>Work in progress...</i>
    </p>


    <!-- SECCIONES -->
    <h2 class="text-5xl mt-14 text-center font-bold mb-4" style="color: #1E90FF;">Secciones:</h2>

    <a href="<%= proyectos_subsection_path(section: 'pc') %>" style="color: #1E90FF;">
    </a>
    <% if @subsections['PC'].present? %>
      <div class="flex flex-col items-center"> 
        <ul class="list-inside text-experimentos text-left mt-2">
          <% @subsections['PC'].each_with_index do |sub_section, index| %>
            <li>
              <a href="<%= proyectos_subsection_path(section: 'pc', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_')) %>" style="color: #1E90FF;" class="text-2xl font-bold flex items-center">
                <%= if @new_subsections['PC'] && @new_subsections['PC'].include?(sub_section)
                      raw("<span class='underline'>7.#{index + 1} #{sub_section}</span> <span class='ml-1 mr-1 material-symbols-outlined' style='color: #1E90FF !important;font-size: 22px;'>release_alert</span>")
                    else
                      raw("<span class='underline'>7.#{index + 1} #{sub_section}</span>")
                    end %>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>
</div>