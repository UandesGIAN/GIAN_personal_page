<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-6xl md:text-8xl sm:text-8xl xs:text-4xl text-center mb-2 text-blue-700 animate-slide-in-right">
    <span class="text-shadow-proyectos">Mis proyectos:</span> <p class="mt-10" style="color: #8600c9; text-shadow: 0px 2px 20px rgba(134, 0, 201, 0.6);">Celulares</p>
  </h1>
</div>

<%= @indice_content %>

<div class="text-container max-w-7xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section id="bg-articulos" class="p-6 
    <%= 'bg-gray-200 sm:bg-gray-300 text-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900 text-gray-300' if @modo_luz == 'oscuro' %> 
    rounded-2xl shadow-md flex-grow">
    <h2 class="text-4xl sm:text-3xl lg:text-5xl mt-2 text-center font-bold mb-4" style="color: #8600c9;">4. Iphone SE</h2>

    <p class="mb-6 text-lg">
      <i>Work In Progress...</i>
    </p>

    <div class="flex justify-between items-center">
        <div>
            <a href="<%= proyectos_subsection_path(section: 'celulares', sub_section: 'samsung_j1_ace') %>" 
                class="text-white py-3 px-4 rounded-md transition-all"
                style="background-color: rgb(134, 0, 201);"
                onmouseover="this.style.backgroundColor='rgb(100, 0, 150)'"
                onmouseout="this.style.backgroundColor='rgb(134, 0, 201)'">
                Anterior capítulo
            </a>
        </div>
        <div>
            <a href="<%= proyectos_subsection_path(section: 'celulares', sub_section: 'iphone_12_mini') %>" 
                class="text-white py-3 px-4 rounded-md transition-all"
                style="background-color: rgb(134, 0, 201);"
                onmouseover="this.style.backgroundColor='rgb(100, 0, 150)'"
                onmouseout="this.style.backgroundColor='rgb(134, 0, 201)'">
                Siguiente capítulo
            </a>
        </div>
    </div>

  </section>
</div>


<% stats = stats_for_page(request.path) %>
<div class="text-container max-w-7xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section id="bg-articulos" class="p-6 
    <%= 'bg-gray-200 sm:bg-gray-300 text-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900 text-gray-300' if @modo_luz == 'oscuro' %> 
    rounded-2xl shadow-md flex-grow">
    <h2 class="text-5xl mt-4 text-center font-bold mb-8" style="color: #8600c9;">Estadísticas de esta página</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
        <div class="<%= 'bg-indigo-200 text-gray-800' if @modo_luz == 'claro' %> 
        <%= 'bg-indigo-500 text-gray-900' if @modo_luz == 'oscuro' %> rounded-lg p-4">
        <p class="text-lg font-semibold <%= 'text-indigo-800' if @modo_luz == 'claro'%> <%= 'text-indigo-900' if @modo_luz == 'oscuro' %>">Visitas totales</p>
        <p class="text-3xl font-bold"><%= stats["visits"] %></p>
        </div>
        <div class="<%= 'bg-green-200 text-gray-800' if @modo_luz == 'claro' %> 
        <%= 'bg-green-400 text-gray-900' if @modo_luz == 'oscuro' %> rounded-lg p-4">
        <p class="text-lg font-semibold <%= 'text-green-800' if @modo_luz == 'claro'%> <%= 'text-green-900' if @modo_luz == 'oscuro' %>">Usuarios activos</p>
        <p class="text-3xl font-bold"><%= stats["current_users"].length %></p>
        </div>
        <div class="<%= 'bg-yellow-200 text-gray-800' if @modo_luz == 'claro' %> 
        <%= 'bg-yellow-400 text-gray-900' if @modo_luz == 'oscuro' %> rounded-lg p-4">
        <p class="text-lg font-semibold text-yellow-800">Última visita</p>
        <p class="text-lg font-semibold"><%= stats["last_visit"] %></p>
        </div>
    </section>
    </div>
</div>