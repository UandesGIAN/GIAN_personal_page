<!-------------------------------->
<!--        COMPUTACION         -->
<!-------------------------------->

<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-6xl md:text-8xl sm:text-8xl xs:text-4xl mb-2 text-shadow-green computacion-home animate-slide-in-right">
    Computación
  </h1>
</div>

<!-- ESTRUCTURA  -->
<div class="text-container max-w-5xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section id="bg-articulos" class="p-6 
    <%= 'bg-gray-200 sm:bg-gray-300 text-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900 text-gray-300' if @modo_luz == 'oscuro' %> 
    rounded-2xl shadow-md flex-grow">

    <!-- DESCRIPCION -->
    <p class="ml-3 mt-4 mb-12 text-lg leading-9">
        Corresponde a una compilación de proyectos, estudios, ejercicios y creaciones que poseen relación con la informática, computación, tecnología, electrónica e ingeniería.<br>
        <br>Tendrá una estructura de guía para aprender al respecto de todo ello a través de resúmenes y ejercicios aplicados.<br><br>
        <i>Work In Progress...</i>
    </p>

    <!-- SECCIONES -->
    <h2 class="text-5xl mt-14 text-center font-bold mb-4 computacion-home">Secciones:</h2>

    <a href="<%= computacion_subsection_path(section: 'python') %>" class="text-blue-700">
      <h2 class="text-3xl mt-14 ml-6 font-bold mb-2 underline">1. Python</h2>
    </a>
    <% if @subsections['Python'].present? %>
      <ul class="list-inside ml-12 mt-2 mb-12">
        <% @subsections['Python'].each_with_index do |sub_section, index| %>
          <li class="mt-2">
            <a href="<%= computacion_subsection_path(section: 'python', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_').gsub(',', '') ) %>" class="text-blue-700 text-lg font-bold underline">
              <%= "1.#{index + 1} #{sub_section.capitalize}" %>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>


  </section>
</div>
