<!-------------------------------->
<!--     FILOSOFIA DE GIAN      -->
<!-------------------------------->

<div class="relative flex items-center mt-20 mb-10 justify-center h-full animated-element-slide-r">
  <h1 class="font-bold text-center text-6xl md:text-8xl sm:text-8xl xs:text-4xl mb-2 text-shadow-orange filosofia-home animate-slide-in-right">
    Filosofía de GIAN
  </h1>
</div>

<!-- ESTRUCTURA  -->
<div class="text-container max-w-5xl mx-auto mt-20 px-4 flex flex-col pb-8">
  <section id="bg-articulos" class="p-6 
    <%= 'bg-gray-200 sm:bg-gray-300 text-gray-800' if @modo_luz == 'claro' %> 
    <%= 'bg-gray-900 text-gray-300' if @modo_luz == 'oscuro' %> 
    rounded-2xl shadow-md flex-grow">
    <!-- DESCRIPCION -->
    <p class="ml-3 mt-4 mb-12 text-lg leading-9">
        Apartado personal y reflexivo entorno a la vida real y los distintos puntos de vista sobre la realidad.<br>
        <br>Será una compilación de estudios personales y herramientas o conocimientos que se brindan con el fin de ayudar y orientar al lector.
        <br><br>
        <i>Work In Progress...</i>
    </p>

    <!-- SECCIONES -->
    <h2 class="text-5xl mt-14 text-center font-bold mb-4 filosofia-home">Secciones:</h2>

    <!-- EL METODO DE GIAN -->
    <a href="<%= filosofia_subsection_path(section: 'el_metodo_de_gian') %>" class="text-green-600">
      <h2 class="text-3xl mt-14 ml-6 font-bold mb-2 underline">1. EL MÉTODO DE GIAN</h2>
    </a>
    <% if @subsections['EL MÉTODO DE GIAN'].present? %>
      <ul class="list-inside ml-12 mt-2 mb-12">
        <% @subsections['EL MÉTODO DE GIAN'].each_with_index do |sub_section, index| %>
          <li class="mt-2">
            <a href="<%= filosofia_subsection_path(section: 'el_metodo_de_gian', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_')) %>" class="text-green-600 mt-2 text-lg font-bold underline">
              <%= "1.#{index + 1} #{sub_section.capitalize}" %>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>


    <!-- LAS MANERAS -->
    <a href="<%= filosofia_subsection_path(section: 'las_maneras') %>" class="text-blue-400">
      <h2 class="text-3xl mt-6 ml-6 font-bold mb-2 underline text-yellow-500">2. LAS MANERAS</h2>
    </a>

    <% if @subsections['LAS MANERAS'].present? %>
      <ul class="list-inside ml-12 mt-2 mb-12">
        <% @subsections['LAS MANERAS'].each_with_index do |sub_section, index| %>
          <li class="mt-2">
            <a href="<%= filosofia_subsection_path(section: 'las_maneras', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_')) %>" class="text-yellow-500 mt-2 text-lg font-bold underline">
              <%= "2.#{index + 1} #{sub_section.capitalize}" %>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>


    <!-- LOS ELEMENTOS DE VIDA -->
    <a href="<%= filosofia_subsection_path(section: 'los_elementos_de_vida') %>" class="text-blue-400">
      <h2 class="text-3xl mt-6 ml-6 font-bold mb-2 underline" style="color: #8000B3;">3. LOS ELEMENTOS DE VIDA</h2>
    </a>

    <% if @subsections['LOS ELEMENTOS DE VIDA'].present? %>
      <ul class="list-inside ml-12 mt-2 mb-12">
        <% @subsections['LOS ELEMENTOS DE VIDA'].each_with_index do |sub_section, index| %>
          <li class="mt-2">
            <a href="<%= filosofia_subsection_path(section: 'los_elementos_de_vida', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_')) %>" style="color: #8000B3;" class="mt-2 text-lg font-bold underline">
              <%= "3.#{index + 1} #{sub_section.capitalize}" %>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>


    <!-- SOBRE ETICA -->
    <a href="<%= filosofia_subsection_path(section: 'etica') %>" class="text-blue-400">
      <h2 class="text-3xl mt-6 ml-6 font-bold mb-2 underline text-gray-500">4. Sobre Ética y Moral</h2>
    </a>

    <% if @subsections['Ética'].present? %>
      <ul class="list-inside ml-12 mt-2 mb-12">
        <% @subsections['Ética'].each_with_index do |sub_section, index| %>
          <li class="mt-2">
            <a href="<%= filosofia_subsection_path(section: 'etica', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_')) %>" class="text-gray-500 mt-2 text-lg font-bold underline">
              <%= "4.#{index + 1} #{sub_section}" %>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>


    <!-- SOBRE TEOLOGIA -->
    <a href="<%= filosofia_subsection_path(section: 'teologia') %>" class="text-blue-400">
      <h2 class="text-3xl mt-6 ml-6 font-bold mb-2 underline" style="color: #58A7A4;" >5. Sobre Teología</h2>
    </a>

    <% if @subsections['Teología'].present? %>
      <ul class="list-inside ml-12 mt-2 mb-12">
        <% @subsections['Teología'].each_with_index do |sub_section, index| %>
          <li class="mt-2">
            <a href="<%= filosofia_subsection_path(section: 'teologia', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_')) %>" style="color: #58A7A4;" class="mt-2 text-lg font-bold underline">
              <%= "5.#{index + 1} #{sub_section}" %>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>


    <!-- SOBRE EL ARTE -->
    <a href="<%= filosofia_subsection_path(section: 'arte') %>" class="text-blue-400">
      <h2 class="text-3xl mt-6 ml-6 font-bold mb-2 underline" style="color: #57380a;">6. Sobre el Arte</h2>
    </a>

    <% if @subsections['Arte'].present? %>
      <ul class="list-inside ml-12 mt-2 mb-12">
        <% @subsections['Arte'].each_with_index do |sub_section, index| %>
          <li class="mt-2">
            <a href="<%= filosofia_subsection_path(section: 'arte', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_')) %>" style="color: #57380a;" class="mt-2 text-lg font-bold underline">
              <%= "6.#{index + 1} #{sub_section}" %>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>

    <!-- SOBRE LA PSICOLOGÍA -->
    <a href="<%= filosofia_subsection_path(section: 'psicologia') %>" class="text-blue-400">
      <h2 class="text-3xl mt-6 ml-6 font-bold mb-2 underline" style="color: #83B72A;">7. Sobre la Psicología</h2>
    </a>

    <% if @subsections['Psicología'].present? %>
      <ul class="list-inside ml-12 mt-2 mb-12">
        <% @subsections['Psicología'].each_with_index do |sub_section, index| %>
          <li class="mt-2">
            <a href="<%= filosofia_subsection_path(section: 'psicologia', sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_')) %>" style="color: #83B72A;" class="mt-2 text-lg font-bold underline">
              <%= "7.#{index + 1} #{sub_section}" %>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>

  </section>
</div>