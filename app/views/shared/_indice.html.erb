<div id="movable-button" class="fixed left-5 p-3 bg-gray-500 opacity-55 text-white rounded-full cursor-pointer">
  Índice
</div>

<div id="dropdown-menu" class="hidden fixed w-60 bg-gray-300 border mt-10 border-gray-400 rounded-lg shadow-lg p-4 text-gray-800">
  <ul class="list-inside ml-4 mt-2">
    <li>
      <a href="<%= send("#{type_url}_subsection_path") %>" 
         class="<%= case type_url
                   when 'proyectos'
                     'text-blue-700'  # Azul para proyectos
                   when 'computacion'
                     'computacion-home'  # Clase personalizada para computación
                   when 'filosofia'
                     'filosofia-home'  # Clase personalizada para filosofía
                   else
                     'text-blue-700'  # Por defecto azul
                   end %> text-xl font-bold underline">
        0. INICIO
      </a>
    </li>

    <% section.each_with_index do |section, index| %>
      <li>
        <% section_fix = section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_').gsub(',', '') %>
        <a href="<%= send("#{type_url}_subsection_path", section: section_fix) %>" 
           class="<%= case type_url
                     when 'proyectos'
                       'text-blue-700'  # Azul para proyectos
                     when 'computacion'
                       'computacion-home'  # Clase personalizada para computación
                     when 'filosofia'
                       'filosofia-home'  # Clase personalizada para filosofía
                     else
                       'text-blue-700'  # Por defecto azul
                     end %> text-xl font-bold underline">
          <%= "#{index + 1}. #{section}" %>
        </a>
      </li>

      <% subsections_key = section %>
      <% if subsections[subsections_key].present? %>
        <ul class="list-inside ml-4 mt-2">
          <% subsections[subsections_key].each_with_index do |sub_section, sub_index| %>
            <li>
              <a href="<%= send("#{type_url}_subsection_path", section: section_fix, sub_section: sub_section.downcase.gsub(/[áéíóúñ]/, 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ñ' => 'n').gsub(' ', '_').gsub(',', '') ) %>" class="text-gray-700 text-lg font-bold underline">
                <%= "#{index + 1}.#{sub_index + 1} #{sub_section}" %>
              </a>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %> 
  </ul> 
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const button = document.getElementById('movable-button');
    const menu = document.getElementById('dropdown-menu');
    let isDragging = false;
    let offsetX, offsetY;

    // Obtiene la ruta actual
    const path = window.location.pathname;
    const sectionMatch = path.match(/\/(proyectos|filosofia|computacion)\/([^\/]+)/); // Extrae la sección de la URL
    const currentSection = sectionMatch ? sectionMatch[2] : null;

    // Filtra el menú de índice según la sección actual
    document.querySelectorAll("#dropdown-menu ul li").forEach(link => {
      const sectionInLink = link.querySelector('a')?.getAttribute("href").match(/\/(proyectos|filosofia|computacion)\/([^\/]+)/);
      const linkSection = sectionInLink ? sectionInLink[2] : null;

      if (linkSection && linkSection !== currentSection) {
        link.style.display = "none";
      } else {
        link.style.display = "block"; // Mostrar solo los que coinciden
      }
    });

    // Función para mover el botón
    function moveAt(clientX, clientY) {
      if (isDragging) {
        button.style.left = clientX - offsetX + 'px';
        button.style.top = clientY - offsetY + 'px';

        menu.style.left = button.style.left;
        menu.style.top = (parseInt(button.style.top) + button.offsetHeight) + 'px';
      }
    }

    // Eventos para dispositivos de escritorio
    button.onmousedown = function(event) {
      isDragging = true;
      offsetX = event.clientX - button.getBoundingClientRect().left;
      offsetY = event.clientY - button.getBoundingClientRect().top;

      function onMouseMove(event) {
        moveAt(event.clientX, event.clientY);
      }

      document.addEventListener('mousemove', onMouseMove);

      button.onmouseup = function() {
        isDragging = false;
        document.removeEventListener('mousemove', onMouseMove);
      };
    };

    button.ondragstart = function() {
      return false;
    };

    // Eventos para dispositivos móviles
    button.addEventListener('touchstart', function(event) {
      isDragging = true;
      const touch = event.touches[0];
      offsetX = touch.clientX - button.getBoundingClientRect().left;
      offsetY = touch.clientY - button.getBoundingClientRect().top;

      function onTouchMove(event) {
        const touch = event.touches[0];
        moveAt(touch.clientX, touch.clientY);
      }

      document.addEventListener('touchmove', onTouchMove);

      button.addEventListener('touchend', function() {
        isDragging = false;
        document.removeEventListener('touchmove', onTouchMove);
      });
    });

    // Toggle del menú
    button.addEventListener('click', function() {
      menu.classList.toggle('hidden');
    });
  });
</script>
